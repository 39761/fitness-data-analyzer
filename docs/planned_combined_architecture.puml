@startuml Gesamtarchitektur_Zielbild

skinparam componentStyle uml2
skinparam packageStyle rectangle

title Geplante Gesamtarchitektur (Zielbild via API)

package "Client-Schicht" {
    component [Fitness-Tracker CLI] as CLI
}

package "Schnittstellen- & Validierungs-Schicht" {
    component [FastAPI Server] as API
    interface "HTTP POST\n/trainings" as API_IN
    interface "HTTP GET\n/trainings" as API_OUT
}

package "Analyse- & Persistenz-Schicht" {
    component [Fitness-Data-Analyzer\n(notebooks/analysis.ipynb)] as Analyzer
    database "Zentrale Datenbank\n(trainings.db)" as DB
}

' Datenfluss: Tracker meldet Trainings an API
CLI --> API_IN : sendet neue Trainingsdaten
API_IN - API

' Datenfluss: Analyzer holt Trainingsdaten von API
Analyzer --> API_OUT : fordert Trainingsdaten an
API_OUT - API

' API verwaltet die DB
API --> DB : schreibt / liest Trainings & Benutzer

note bottom of API
  - Validiert Daten über Pydantic
  - Kapselt die SQL-Datenbanklogik
end note

note bottom of Analyzer
  - Verarbeitet Daten in Pandas-Pipeline
  - Generiert Boxplots & Heatmaps
end note

@enduml